<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime Entitlements for LocalMind -->

	<!-- Allow JIT for PyTorch/llama.cpp performance -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Allow unsigned executable memory (required for JIT) -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- Disable library validation for Python extensions -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Network client for model downloads -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Audio input (optional, for future recording features) -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- User-selected files (open/save dialogs) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Downloads folder access -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
