/*
 * LocalMind Desktop - Dark Theme
 * Google-Quality Design (Material Design 3 Inspired)
 *
 * Color Palette:
 * - Background:      #0F172A (Slate-900)
 * - Surface:         #1E293B (Slate-800)
 * - Surface Variant: #334155 (Slate-700)
 * - Text Primary:    #F8FAFC (Slate-50)
 * - Text Secondary:  #94A3B8 (Slate-400)
 * - Border:          #475569 (Slate-600)
 *
 * Semantic Colors:
 * - Primary:         #818CF8 (Indigo-400)
 * - Primary Hover:   #A5B4FC (Indigo-300)
 * - Success:         #34D399 (Emerald-400)
 * - Warning:         #FBBF24 (Amber-400)
 * - Error:           #F87171 (Red-400)
 * - Info:            #38BDF8 (Sky-400)
 */

/* === Global Styles === */
QWidget {
    background-color: #0F172A;
    color: #F8FAFC;
    font-family: "Inter", "Google Sans", "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
    selection-background-color: #818CF8;
    selection-color: #0F172A;
}

QMainWindow {
    background-color: #0F172A;
}

/* === Frames & Panels === */
QFrame {
    background-color: transparent;
    border: none;
}

QFrame[frameShape="1"] {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 12px;
}

/* Main Panels */
QWidget#leftPanel {
    background-color: #1E293B;
    border-right: 1px solid #475569;
}

QWidget#rightPanel {
    background-color: #0F172A;
}

/* === Buttons === */
QPushButton {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 500;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #64748B;
}

QPushButton:pressed {
    background-color: #475569;
}

QPushButton:focus {
    border: 2px solid #818CF8;
    padding: 9px 17px;
}

QPushButton:disabled {
    background-color: #2D2D2D;
    color: #6B7280;
    border-color: #374151;
}

/* Primary/Accent Button */
QPushButton[accent="true"],
QPushButton#processButton {
    background-color: #6366F1;
    color: #FFFFFF;
    border: none;
}

QPushButton[accent="true"]:hover,
QPushButton#processButton:hover {
    background-color: #818CF8;
}

QPushButton[accent="true"]:pressed,
QPushButton#processButton:pressed {
    background-color: #4F46E5;
}

/* === Text Inputs === */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #2D2D2D;
    color: #FAFAFA;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #6366F1;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #818CF8;
    border-width: 2px;
    padding: 7px 11px;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #242424;
    color: #6B7280;
}

QLineEdit[echoMode="2"] {
    lineedit-password-character: 9679;
}

/* === Combo Box === */
QComboBox {
    background-color: #2D2D2D;
    color: #FAFAFA;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 30px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #4B5563;
}

QComboBox:focus {
    border-color: #818CF8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #242424;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #363636;
    selection-color: #FAFAFA;
}

/* === Spin Box === */
QSpinBox, QDoubleSpinBox {
    background-color: #2D2D2D;
    color: #FAFAFA;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 8px 12px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #818CF8;
}

/* === Check Box & Radio Button === */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #FAFAFA;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator {
    border: 2px solid #4B5563;
    border-radius: 4px;
    background-color: #2D2D2D;
}

QCheckBox::indicator:checked {
    background-color: #6366F1;
    border-color: #6366F1;
}

QRadioButton::indicator {
    border: 2px solid #4B5563;
    border-radius: 9px;
    background-color: #2D2D2D;
}

QRadioButton::indicator:checked {
    background-color: #2D2D2D;
    border-color: #818CF8;
    border-width: 5px;
}

/* === Progress Bar === */
QProgressBar {
    background-color: #374151;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #818CF8;
    border-radius: 4px;
}

/* === Sliders === */
QSlider::groove:horizontal {
    background-color: #374151;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #818CF8;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #A5B4FC;
}

/* === Tables === */
QTableWidget, QTableView {
    background-color: #242424;
    alternate-background-color: #2D2D2D;
    gridline-color: #374151;
    border: 1px solid #374151;
    border-radius: 8px;
    selection-background-color: #312E81;
    selection-color: #FAFAFA;
}

QTableWidget::item, QTableView::item {
    padding: 8px;
    border-bottom: 1px solid #2D2D2D;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #312E81;
    color: #FAFAFA;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #9CA3AF;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #374151;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
}

/* === Tree View & List View === */
QTreeView, QListView {
    background-color: #242424;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 4px;
    alternate-background-color: #2D2D2D;
}

QTreeView::item, QListView::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: #2D2D2D;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #312E81;
    color: #FAFAFA;
}

QTreeView::branch {
    background-color: transparent;
}

/* === Tab Widget === */
QTabWidget::pane {
    background-color: #242424;
    border: 1px solid #374151;
    border-radius: 8px;
    border-top-left-radius: 0;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #9CA3AF;
    padding: 12px 20px;
    margin-right: 4px;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #FAFAFA;
}

QTabBar::tab:selected {
    color: #818CF8;
    border-bottom: 2px solid #818CF8;
}

/* === Scroll Bars === */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #4B5563;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #6B7280;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #4B5563;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #6B7280;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Menu Bar === */
QMenuBar {
    background-color: #242424;
    border-bottom: 1px solid #374151;
    padding: 4px 8px;
    spacing: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #363636;
}

QMenuBar::item:pressed {
    background-color: #404040;
}

/* === Menus === */
QMenu {
    background-color: #242424;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 32px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #363636;
}

QMenu::separator {
    height: 1px;
    background-color: #374151;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 8px;
}

/* === Tool Bar === */
QToolBar {
    background-color: #242424;
    border-bottom: 1px solid #374151;
    spacing: 8px;
    padding: 8px 12px;
}

QToolBar::separator {
    width: 1px;
    background-color: #374151;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px;
    color: #9CA3AF;
}

QToolButton:hover {
    background-color: #363636;
    color: #FAFAFA;
}

QToolButton:pressed {
    background-color: #404040;
}

QToolButton:checked {
    background-color: #312E81;
    color: #818CF8;
}

/* === Status Bar === */
QStatusBar {
    background-color: #242424;
    border-top: 1px solid #374151;
    color: #9CA3AF;
    font-size: 12px;
    padding: 4px 12px;
}

QStatusBar::item {
    border: none;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #374151;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #818CF8;
}

/* === Group Box === */
QGroupBox {
    font-weight: 600;
    border: 1px solid #374151;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: #1A1A1A;
    color: #FAFAFA;
}

/* === Labels === */
QLabel {
    background-color: transparent;
    color: #FAFAFA;
}

QLabel[heading="true"] {
    font-size: 16px;
    font-weight: 600;
}

QLabel[subheading="true"] {
    color: #9CA3AF;
    font-size: 12px;
}

/* === Tool Tips === */
QToolTip {
    background-color: #363636;
    color: #FAFAFA;
    border: 1px solid #4B5563;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* === Dialog === */
QDialog {
    background-color: #1A1A1A;
}

QDialogButtonBox {
    button-layout: 2;
}

/* === Message Box === */
QMessageBox {
    background-color: #242424;
}

QMessageBox QLabel {
    color: #FAFAFA;
}

/* === Specific Widgets === */

/* Score indicators */
QLabel[score="good"] {
    color: #34D399;
    font-weight: 600;
}

QLabel[score="warning"] {
    color: #FBBF24;
    font-weight: 600;
}

QLabel[score="bad"] {
    color: #F87171;
    font-weight: 600;
}

/* Grade badges */
QLabel[grade="A"] {
    background-color: #064E3B;
    color: #6EE7B7;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="B"] {
    background-color: #14532D;
    color: #86EFAC;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="C"] {
    background-color: #78350F;
    color: #FDE68A;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="D"] {
    background-color: #7C2D12;
    color: #FDBA74;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="F"] {
    background-color: #7F1D1D;
    color: #FCA5A5;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

/* === Progress Panel === */

/* Stage widget container */
QFrame#stageWidget {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 12px;
    padding: 0;
}

QFrame#stageWidget:hover {
    border-color: #64748B;
}

/* Stage number indicator */
QLabel#stageIndicator {
    background-color: #334155;
    color: #94A3B8;
    border-radius: 12px;
    font-weight: 600;
}

QLabel#stageIndicator[state="active"] {
    background-color: #818CF8;
    color: #0F172A;
}

QLabel#stageIndicator[state="complete"] {
    background-color: #34D399;
    color: #0F172A;
}

QLabel#stageIndicator[state="error"] {
    background-color: #F87171;
    color: #0F172A;
}

/* Stage name */
QLabel#stageName {
    color: #F8FAFC;
    font-weight: 500;
}

/* Stage status */
QLabel#stageStatus {
    font-size: 12px;
    font-weight: 500;
}

QLabel#stageStatus[state="waiting"] {
    color: #64748B;
}

QLabel#stageStatus[state="active"] {
    color: #818CF8;
}

QLabel#stageStatus[state="complete"] {
    color: #34D399;
}

QLabel#stageStatus[state="error"] {
    color: #F87171;
}

/* Stage time */
QLabel#stageTime {
    color: #94A3B8;
    font-size: 12px;
    font-family: "JetBrains Mono", "Fira Code", monospace;
}

/* Progress header */
QLabel#progressHeader {
    color: #F8FAFC;
}

/* Total time */
QLabel#totalTime {
    color: #94A3B8;
    font-size: 13px;
    font-family: "JetBrains Mono", "Fira Code", monospace;
}

/* Overall status */
QLabel#overallStatus {
    padding: 12px;
    border-radius: 8px;
    font-weight: 500;
}

QLabel#overallStatus[state="idle"] {
    background-color: #334155;
    color: #94A3B8;
}

QLabel#overallStatus[state="active"] {
    background-color: #312E81;
    color: #A5B4FC;
}

QLabel#overallStatus[state="complete"] {
    background-color: #064E3B;
    color: #6EE7B7;
}

QLabel#overallStatus[state="error"] {
    background-color: #7F1D1D;
    color: #FECACA;
}

QLabel#overallStatus[state="warning"] {
    background-color: #78350F;
    color: #FDE68A;
}

/* Stage log panel */
QTextEdit#stageLogPanel {
    background-color: #0F172A;
    border: 1px solid #475569;
    border-radius: 6px;
    color: #94A3B8;
    font-size: 11px;
    padding: 8px;
}

/* Expand button */
QPushButton#expandButton {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#expandButton:hover {
    color: #818CF8;
}

/* === Results Viewer === */

/* Score gauge card */
QFrame#scoreGaugeCard {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 12px;
    min-width: 140px;
    max-width: 180px;
}

QFrame#scoreGaugeCard:hover {
    border-color: #64748B;
}

/* Scores container */
QFrame#scoresContainer {
    background-color: transparent;
}

/* Transcript viewer */
QTextEdit#transcriptViewer {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 12px;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: #F8FAFC;
}

/* Feedback viewer */
QTextEdit#feedbackViewer {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 12px;
    font-size: 13px;
    color: #F8FAFC;
}

/* Raw JSON viewer */
QTextEdit#rawJsonViewer {
    background-color: #0F172A;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 12px;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 11px;
    color: #94A3B8;
}

/* Score details table */
QTableWidget#scoreDetailsTable {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 8px;
}

/* Results tab widget */
QTabWidget#resultsTabWidget::pane {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 8px;
    border-top-left-radius: 0;
}

/* === Drop Zone === */
QFrame#dropZone {
    background-color: #1E293B;
    border: 2px dashed #475569;
    border-radius: 16px;
}

QFrame#dropZone:hover {
    border-color: #818CF8;
    background-color: #312E81;
}

QFrame#dropZone[dragOver="true"] {
    border-color: #818CF8;
    border-style: solid;
    background-color: #312E81;
}

QLabel#dropZoneTitle {
    font-size: 18px;
    font-weight: 600;
    color: #F8FAFC;
}

QLabel#dropZoneSubtitle {
    font-size: 14px;
    color: #94A3B8;
}

QLabel#dropZoneFormats {
    font-size: 12px;
    color: #64748B;
}

/* Selected File Container */
QFrame#selectedFileContainer {
    background-color: #312E81;
    border: 1px solid #4338CA;
    border-radius: 12px;
}

QLabel#selectedFileName {
    font-size: 14px;
    font-weight: 600;
    color: #F8FAFC;
}

/* Batch Queue */
QFrame#batchQueueContainer {
    background-color: #064E3B;
    border: 1px solid #059669;
    border-radius: 12px;
}

QListWidget#batchQueueList {
    background-color: transparent;
    border: none;
    font-size: 13px;
    color: #F8FAFC;
}

QListWidget#batchQueueList::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QListWidget#batchQueueList::item:selected {
    background-color: #065F46;
}

QPushButton#queueButton {
    background-color: #064E3B;
    color: #34D399;
    border: 1px solid #059669;
}

QPushButton#queueButton:hover {
    background-color: #065F46;
}

/* === Quick Access === */
QFrame#quickAccessItem {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QFrame#quickAccessItem:hover {
    background-color: #334155;
    border-color: #475569;
}

QLabel#quickAccessName {
    font-size: 14px;
    color: #F8FAFC;
}

/* === Recent Files === */
QFrame#recentFileItem {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QFrame#recentFileItem:hover {
    background-color: #334155;
    border-color: #475569;
}

QLabel#recentFileName {
    font-size: 13px;
    font-weight: 500;
    color: #F8FAFC;
}

QLabel#recentFileFolder {
    font-size: 11px;
    color: #94A3B8;
}

/* === Section Headers === */
QLabel#sectionHeader {
    font-size: 12px;
    font-weight: 600;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* === Mode Toggle === */
QFrame#modeToggle {
    background-color: #334155;
    border-radius: 10px;
}

QPushButton#modeButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    font-weight: 500;
    color: #94A3B8;
    padding: 8px 24px;
}

QPushButton#modeButton:hover {
    background-color: #475569;
}

QPushButton#modeButton[active="true"] {
    background-color: #1E293B;
    color: #818CF8;
    font-weight: 600;
}

/* === Provider Selector === */
QFrame#providerSelector {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 12px;
}

QLabel#fieldLabel {
    font-size: 13px;
    font-weight: 500;
    color: #94A3B8;
    min-width: 80px;
}

QComboBox#providerCombo,
QComboBox#modelCombo,
QComboBox#whisperModelCombo {
    background-color: #0F172A;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #F8FAFC;
}

QComboBox#providerCombo:hover,
QComboBox#modelCombo:hover,
QComboBox#whisperModelCombo:hover {
    border-color: #64748B;
}

QComboBox#providerCombo:focus,
QComboBox#modelCombo:focus,
QComboBox#whisperModelCombo:focus {
    border-color: #818CF8;
}

QLineEdit#apiKeyInput {
    background-color: #0F172A;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #F8FAFC;
}

QLineEdit#apiKeyInput:focus {
    border-color: #818CF8;
}

QLabel#apiStatus {
    font-size: 12px;
    color: #FBBF24;
}

QLabel#apiStatus[valid="true"] {
    color: #34D399;
}

/* === Offline Settings === */
QFrame#offlineSettings {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 12px;
}

QLabel#offlineInfo {
    font-size: 13px;
    color: #34D399;
    font-weight: 500;
    padding: 8px;
    background-color: #064E3B;
    border-radius: 8px;
}

