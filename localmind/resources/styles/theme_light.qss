/*
 * LocalMind Desktop - Light Theme
 * Google-Quality Design (Material Design 3 Inspired)
 *
 * Color Palette:
 * - Background:      #F8FAFC (Slate-50)
 * - Surface:         #FFFFFF (White)
 * - Surface Variant: #F1F5F9 (Slate-100)
 * - Text Primary:    #0F172A (Slate-900)
 * - Text Secondary:  #64748B (Slate-500)
 * - Border:          #E2E8F0 (Slate-200)
 *
 * Semantic Colors:
 * - Primary:         #4F46E5 (Indigo-600)
 * - Primary Hover:   #4338CA (Indigo-700)
 * - Success:         #059669 (Emerald-600)
 * - Warning:         #D97706 (Amber-600)
 * - Error:           #DC2626 (Red-600)
 * - Info:            #0284C7 (Sky-600)
 *
 * Typography:
 * - Font Family: Inter, Google Sans, SF Pro Display, system-ui
 * - Body: 14px, Heading: 16-24px, Caption: 12px
 *
 * Elevation (box-shadow):
 * - Level 1: 0 1px 3px rgba(0,0,0,0.12)
 * - Level 2: 0 4px 6px rgba(0,0,0,0.12)
 */

/* === Global Styles === */
QWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Inter", "Google Sans", "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QMainWindow {
    background-color: #F8FAFC;
}

/* === Frames & Panels === */
QFrame {
    background-color: transparent;
    border: none;
}

QFrame[frameShape="1"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

/* === Buttons === */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 500;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton:focus {
    border: 2px solid #4F46E5;
    padding: 9px 17px;
}

/* Primary/Accent Button */
QPushButton[accent="true"],
QPushButton#processButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton[accent="true"]:hover,
QPushButton#processButton:hover {
    background-color: #4338CA;
}

QPushButton[accent="true"]:pressed,
QPushButton#processButton:pressed {
    background-color: #3730A3;
}

/* Success Button */
QPushButton[variant="success"] {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
}

QPushButton[variant="success"]:hover {
    background-color: #047857;
}

/* Danger Button */
QPushButton[variant="danger"] {
    background-color: #DC2626;
    color: #FFFFFF;
    border: none;
}

QPushButton[variant="danger"]:hover {
    background-color: #B91C1C;
}

/* Ghost Button */
QPushButton[variant="ghost"] {
    background-color: transparent;
    border: none;
    color: #64748B;
}

QPushButton[variant="ghost"]:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

/* === Text Inputs === */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 14px;
    selection-background-color: #4F46E5;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #CBD5E1;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #4F46E5;
    border-width: 2px;
    padding: 9px 13px;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

QLineEdit[echoMode="2"] {
    lineedit-password-character: 9679;
}

/* Placeholder text */
QLineEdit::placeholder {
    color: #94A3B8;
}

/* === Combo Box === */
QComboBox {
    background-color: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 30px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #D1D5DB;
}

QComboBox:focus {
    border-color: #6366F1;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #F3F4F6;
    selection-color: #1A1A1A;
}

/* === Spin Box === */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 8px 12px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #6366F1;
}

/* === Check Box & Radio Button === */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #1A1A1A;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator {
    border: 2px solid #D1D5DB;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #6366F1;
    border-color: #6366F1;
}

QRadioButton::indicator {
    border: 2px solid #D1D5DB;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #FFFFFF;
    border-color: #6366F1;
    border-width: 5px;
}

/* === Progress Bar === */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 6px;
    height: 10px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4F46E5;
    border-radius: 6px;
}

/* Progress bar variants */
QProgressBar[status="success"]::chunk {
    background-color: #059669;
}

QProgressBar[status="warning"]::chunk {
    background-color: #D97706;
}

QProgressBar[status="error"]::chunk {
    background-color: #DC2626;
}

QProgressBar[status="processing"]::chunk {
    background-color: #0284C7;
}

/* === Sliders === */
QSlider::groove:horizontal {
    background-color: #E2E8F0;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #4F46E5;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #4338CA;
}

QSlider::handle:horizontal:pressed {
    background-color: #3730A3;
}

/* === Tables === */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    gridline-color: #E2E8F0;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    selection-background-color: #EEF2FF;
    selection-color: #0F172A;
}

QTableWidget::item, QTableView::item {
    padding: 8px;
    border-bottom: 1px solid #F3F4F6;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #EEF2FF;
    color: #1A1A1A;
}

QHeaderView::section {
    background-color: #F9FAFB;
    color: #6B7280;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #E5E7EB;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
}

/* === Tree View & List View === */
QTreeView, QListView {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 4px;
    alternate-background-color: #F9FAFB;
}

QTreeView::item, QListView::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: #F3F4F6;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #EEF2FF;
    color: #1A1A1A;
}

QTreeView::branch {
    background-color: transparent;
}

/* === Tab Widget === */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    border-top-left-radius: 0;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #6B7280;
    padding: 12px 20px;
    margin-right: 4px;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #1A1A1A;
}

QTabBar::tab:selected {
    color: #6366F1;
    border-bottom: 2px solid #6366F1;
}

/* === Scroll Bars === */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #D1D5DB;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Menu Bar === */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
    padding: 4px 8px;
    spacing: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #F3F4F6;
}

QMenuBar::item:pressed {
    background-color: #E5E7EB;
}

/* === Menus === */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 32px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #F3F4F6;
}

QMenu::separator {
    height: 1px;
    background-color: #E5E7EB;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 8px;
}

/* === Tool Bar === */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
    spacing: 8px;
    padding: 8px 12px;
}

QToolBar::separator {
    width: 1px;
    background-color: #E5E7EB;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px;
    color: #6B7280;
}

QToolButton:hover {
    background-color: #F3F4F6;
    color: #1A1A1A;
}

QToolButton:pressed {
    background-color: #E5E7EB;
}

QToolButton:checked {
    background-color: #EEF2FF;
    color: #6366F1;
}

/* === Status Bar === */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5E7EB;
    color: #6B7280;
    font-size: 12px;
    padding: 4px 12px;
}

QStatusBar::item {
    border: none;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #E5E7EB;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #6366F1;
}

/* === Group Box === */
QGroupBox {
    font-weight: 600;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: #FAFAFA;
    color: #1A1A1A;
}

/* === Labels === */
QLabel {
    background-color: transparent;
    color: #1A1A1A;
}

QLabel[heading="true"] {
    font-size: 16px;
    font-weight: 600;
}

QLabel[subheading="true"] {
    color: #6B7280;
    font-size: 12px;
}

/* === Tool Tips === */
QToolTip {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* === Dialog === */
QDialog {
    background-color: #FAFAFA;
}

QDialogButtonBox {
    button-layout: 2;
}

/* === Message Box === */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #1A1A1A;
}

/* === Specific Widgets === */

/* Score indicators */
QLabel[score="good"] {
    color: #10B981;
    font-weight: 600;
}

QLabel[score="warning"] {
    color: #F59E0B;
    font-weight: 600;
}

QLabel[score="bad"] {
    color: #EF4444;
    font-weight: 600;
}

/* Grade badges */
QLabel[grade="A"] {
    background-color: #D1FAE5;
    color: #065F46;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="B"] {
    background-color: #DCFCE7;
    color: #166534;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="C"] {
    background-color: #FEF3C7;
    color: #92400E;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="D"] {
    background-color: #FFEDD5;
    color: #9A3412;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}

QLabel[grade="F"] {
    background-color: #FEE2E2;
    color: #991B1B;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}
